<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tutienda.inventario.ui.InventarioController" style="-fx-background-color: #121212;">

    <!-- HEADER -->
    <VBox spacing="8" style="-fx-background-color: #1A1A1C; -fx-border-color: #2a2a2a; -fx-border-width: 0 0 1 0;">
        <padding><Insets top="14" left="16" right="16" bottom="12"/></padding>
        <Label text="INVENTARIO - MARCA / REFERENCIA | TALLAS | FOTO" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #e0e0e0; -fx-letter-spacing: 0.5;"/>
        <HBox spacing="12">
            <TextField fx:id="txtBuscar" HBox.hgrow="ALWAYS" promptText="🔍 Buscar producto con su fila correspondiente (tallas, cantidad total y foto)" style="-fx-background-color: #242426; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 8; -fx-border-color: #2a2a2a; -fx-border-radius: 8; -fx-padding: 8 12;"/>
            <Pagination fx:id="pagination" maxWidth="340" style="-fx-background-color: transparent;"/>
        </HBox>
    </VBox>

    <!-- TABLA -->
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" style="-fx-background-color: #121212;"/>

    <!-- FOOTER PROFESIONAL -->
    <VBox spacing="10" style="-fx-background-color: #1A1A1C; -fx-border-color: #10B981; -fx-border-width: 1 0 0 0;">
        <padding><Insets top="12" left="14" right="14" bottom="12"/></padding>

        <!-- FILA 1: CATALOGO + PRODUCTO (ALTA FRECUENCIA) -->
        <HBox spacing="12" alignment="CENTER_LEFT">

            <!-- GRUPO: CATALOGO -->
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-background-color: #242426; -fx-background-radius: 10; -fx-padding: 8 12; -fx-border-color: #333; -fx-border-radius: 10;">
                <Label text="CATÁLOGO" style="-fx-text-fill: #888; -fx-font-size: 9; -fx-font-weight: bold;"/>
                <TextField fx:id="txtNuevaMarca" promptText="Ej: NIKE, ADIDAS, PUMA" prefWidth="165" style="-fx-background-color: #2d2d2d; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 6; -fx-border-color: #333; -fx-border-radius: 6;"/>
                <Button text="Crear Marca" onAction="#onAgregarMarca" style="-fx-background-color: #374151; -fx-text-fill: #e0e0e0; -fx-background-radius: 6; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

            <Separator orientation="VERTICAL" prefHeight="32" style="-fx-background-color: #333;"/>

            <!-- GRUPO: PRODUCTO - FOCO PRINCIPAL -->
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-background-color: #1e2e24; -fx-background-radius: 10; -fx-padding: 8 12; -fx-border-color: #10B98133; -fx-border-radius: 10;">
                <Label text="PRODUCTO" style="-fx-text-fill: #10B981; -fx-font-size: 9; -fx-font-weight: bold;"/>
                <ComboBox fx:id="cbMarcas" prefWidth="145" promptText="Marca" style="-fx-background-color: #2d2d2d; -fx-background-radius: 6;"/>
                <TextField fx:id="txtRef" promptText="Ref: ART: 001-808" prefWidth="150" style="-fx-background-color: #2d2d2d; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 6; -fx-border-color: #333; -fx-border-radius: 6;"/>
                <TextField fx:id="txtNombre" promptText="Nombre: FOR ONE BLANCO" prefWidth="170" style="-fx-background-color: #2d2d2d; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 6; -fx-border-color: #333; -fx-border-radius: 6;"/>
                <Button text="＋ Producto" onAction="#onAgregarProducto" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, #10B98144, 10, 0, 0, 2);"/>
            </HBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblInfo" style="-fx-text-fill: #888; -fx-font-size: 11; -fx-font-weight: bold;"/>
        </HBox>

        <!-- FILA 2: OPERACIONES + SISTEMA -->
        <HBox spacing="10" alignment="CENTER_LEFT">

            <!-- OPERACIONES DIARIAS -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnCambio" text="♻ Cambio Talla/Modelo" onAction="#onRealizarCambio" style="-fx-background-color: #1e293b; -fx-text-fill: #FBBF24; -fx-border-color: #F59E0B66; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 12;"/>
                <Button fx:id="btnAgregarFoto" text="📷 Agregar Foto" onAction="#onAgregarFoto" style="-fx-background-color: #1e293b; -fx-text-fill: #93C5FD; -fx-border-color: #3B82F666; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11; -fx-cursor: hand; -fx-padding: 6 12;"/>
                <Separator orientation="VERTICAL" prefHeight="20"/>
                <Button text="📜 Historial General" onAction="#onVerHistorialGeneral" style="-fx-background-color: #242426; -fx-text-fill: #60A5FA; -fx-border-color: #3B82F666; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 12;"/>
                <Button text="👁 Ver Historial del Seleccionado" onAction="#onVerHistorialSeleccionado" style="-fx-background-color: transparent; -fx-text-fill: #93C5FD; -fx-border-color: #3B82F6; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11; -fx-cursor: hand; -fx-padding: 6 12;"/>
            </HBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <!-- SISTEMA + CONTADOR -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <HBox spacing="6" alignment="CENTER_RIGHT" style="-fx-background-color: #242426; -fx-background-radius: 8; -fx-padding: 5 10; -fx-border-color: #2a2a2a; -fx-border-radius: 8;">
                    <Label text="SISTEMA" style="-fx-text-fill: #666; -fx-font-size: 9; -fx-font-weight: bold;"/>
                    <Button text="💾 Backup" onAction="#onBackup" style="-fx-background-color: #065F46; -fx-text-fill: #6EE7B7; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 11; -fx-cursor: hand; -fx-padding: 6 12;"/>
                    <Button text="♻ Restore" onAction="#onRestore" style="-fx-background-color: #374151; -fx-text-fill: #d1d5db; -fx-background-radius: 6; -fx-font-size: 11; -fx-cursor: hand; -fx-padding: 6 10;"/>
                </HBox>
            </HBox>
        </HBox>
    </VBox>
</VBox>
